# انسخ الملف ده لـ.env على السيرفر واملا القيم الحقيقية.
# .env متجاهَل في git ومش بيترفع — القيم الحقيقية بتفضل على السيرفر بس.

# قاعدة البيانات (Neon) — لازم ?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

SESSION_COOKIE_NAME="erp_session"

# مراقبة الأخطاء (Sentry) — اختياري، سيبهم فاضيين لو مش مستخدمهم
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# تخزين الملفات (Cloudflare R2) — لشعار الشركة
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_ENDPOINT=""

# إرسال البريد (Resend)
RESEND_API_KEY=""

# دخول تجريبي بضغطة واحدة من /start من غير كلمة سر — للعرض بس.
# خلّيها "false" (أو امسحها) لو النظام هيتستخدم ببيانات حقيقية.
ALLOW_DEMO_LOGIN="false"
